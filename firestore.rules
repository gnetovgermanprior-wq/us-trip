rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Put the same Google emails here as in `admins` in index.html
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['YOUR-EMAIL@gmail.com'];
    }
    function okText(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 140
        && d.day is string && d.author is string && d.author.size() <= 40
        && d.note is string && d.note.size() <= 400
        && d.price is string && d.price.size() <= 40;
    }
    match /items/{id} {
      allow read: if true;
      // Anyone can suggest; new cards always start as "suggested" with 0 likes
      allow create: if okText(request.resource.data)
        && request.resource.data.status == 'suggested'
        && request.resource.data.likes == 0;
      // Anyone can like/unlike (likes only, by 1); admins can change anything
      allow update: if isAdmin()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && request.resource.data.likes - resource.data.likes in [-1, 1]);
      allow delete: if isAdmin();
    }
  }
}
